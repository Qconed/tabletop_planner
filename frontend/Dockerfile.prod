# Multi-stage production image for the Angular frontend
FROM node:20-slim AS builder
WORKDIR /app

COPY package*.json ./
# Install all dependencies including devDependencies needed for build
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine AS runner

# Remove default config and copy project assets
RUN rm -f /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist/tabletopplanner-frontend/browser /usr/share/nginx/html
COPY certs /etc/nginx/certs
COPY nginx.conf /etc/nginx/conf.d/default.conf

RUN chmod 600 /etc/nginx/certs/*key.pem

EXPOSE 443

CMD ["nginx", "-g", "daemon off;"]
