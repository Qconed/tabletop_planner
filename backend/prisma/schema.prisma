generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
  // what openSSL binaries to use by prisma to ensure secure comms with DB.
  // native: use the installed dependencies for the dev
  // linux-musl-openssl-3.0.x: for alpine-based containers
  // debian-openssl-3.0.x: for debian-based node:20-slim containers
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // made the choice to stay with prisma version of 5.22.0 to be able to use the URL syntax
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}
