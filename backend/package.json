{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend for TTPlanner",
  "main": "server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "npx prisma studio --port 5555 --hostname 0.0.0.0",
    "dev:compose": "npm run prisma:generate && npm run prisma:migrate:deploy && npm run dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "express": "^5.2.1",
    "prisma": "^5.22.0",
    "tsx": "^4.21.0"
  }
}
