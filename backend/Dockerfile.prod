# Multi-stage production image for the backend API
# Stage 1: build TypeScript sources and Prisma client
FROM node:20-slim AS builder
WORKDIR /app

# Install dependencies needed for building (includes devDependencies)
COPY package*.json ./
COPY tsconfig.json ./
COPY prisma ./prisma
RUN npm ci
RUN npm run prisma:generate

# Compile the TypeScript sources
COPY src ./src
RUN npm run build

# Stage 2: runtime image with only production dependencies
FROM node:20-slim AS runner
WORKDIR /app

# Install system packages required by Prisma
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm ci --omit=dev

# Copy Prisma schema for migrations and compiled server output
COPY prisma ./prisma

# Copy generated Prisma Client from builder stage
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma
COPY --from=builder /app/dist ./dist

ENV NODE_ENV=production
EXPOSE 3000

# Apply schema changes before starting the server
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/server.js"]
